# HubSpot Private App token (scopes required below). Create in:
# HubSpot > Settings > Integrations > Private Apps > Create a private app
# Scopes: sales-email-read, crm.objects.contacts.read, crm.objects.owners.read
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: password to protect the dashboard (Basic auth via middleware).
# Leave empty to disable protection.
DASHBOARD_PASSWORD=

# Date window (inclusive) used to scope sequence emails. YYYY-MM-DD.
# Leave START empty to default to the first day of the current month.
WINDOW_START=
WINDOW_END=
